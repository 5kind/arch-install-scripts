_termux_arch_chroot() {
    compopt +o dirnames
    local cur prev opts i
    _init_completion -n : || return
    opts="-h -A -R -S -F -l -u -r -b -v -f -N -n"

    for i in "${COMP_WORDS[@]:1:COMP_CWORD-1}"; do
        if [[ -d ${i} ]]; then
            return 0
        fi
    done

    case ${prev} in
        -u)
            _usergroup -u
            return 0
            ;;
        -b|-v|-f)
            _filedir
            return 0
            ;;
        -n)
            return 0
            ;;
    esac

    if [[ ${cur} = -* ]]; then
        COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
        return 0
    fi
    compopt -o dirnames
}

complete -F _termux_arch_chroot termux-arch-chroot
